<odoo>
    <data>
        <record id="view_invoice_tree" model="ir.ui.view">
            <field name="name">account.move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="is_zatca" invisible="1"/>
                    <field name="l10n_sa_zatca_status" widget="badge"
                           decoration-success="l10n_sa_zatca_status in ['REPORTED','CLEARED']"
                           decoration-danger="l10n_sa_zatca_status in ['Error in reporting', 'Error in clearance']"
                           invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund')"
                           attrs="{'invisible': [['is_zatca', '=', False]]}"
                           groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                </field>
            </field>
        </record>
        <record id="account_move_view" model="ir.ui.view">
            <field name="name">account.move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="l10n_sa_invoice_type_is_readonly" invisible="1"/>
                    <field name="zatca_compliance_invoices_api" invisible="1"/>
                    <field name="l10n_sa_phase1_end_date" invisible="1"/>
                    <field name="zatca_onboarding_status" invisible="1"/>
                    <field name="l10n_sa_invoice_type" invisible="1"/>
                    <field name="zatca_status_code" invisible="1"/>
                    <field name="zatca_invoice" invisible="1"/>
                    <field name="is_zatca" invisible="1"/>

<!--                    <button name="create_xml_file" type="object" string="Generate Zatca XML" class="oe_highlight"/>-->
<!--                    <button name="create_xml_file" type="object" string="Generate Zatca XML" class="oe_highlight"-->
<!--                            attrs="{'invisible':['|', ('state','!=','posted'), ('zatca_invoice_name','not in', [0, None, '', False])]}"/>-->

                    <button name="send_for_compliance" type="object" string="Send to Zatca for Compliance" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('zatca_compliance_invoices_api','not in', [0, None, '', False]), ('zatca_onboarding_status','=', True), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                    <button name="send_for_clearance" type="object" string="Send to Zatca for Clearance" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('l10n_sa_invoice_type','!=', 'Standard'), ('zatca_compliance_invoices_api','not in', [0, None, '', False]), ('zatca_onboarding_status','=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                    <button name="send_for_reporting" type="object" string="Send to Zatca for Reporting" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('l10n_sa_invoice_type','!=', 'Simplified'), ('zatca_compliance_invoices_api','not in', [0, None, '', False]), ('zatca_onboarding_status','=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
<!--                    Resend in case of 400-->
                    <button name="send_for_compliance" type="object" string="ReSend to Zatca for Compliance" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('zatca_onboarding_status','=', True), ('zatca_status_code','!=','400'), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            context="{'xml_generate': 1}" groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                    <button name="send_for_clearance" type="object" string="ReSend to Zatca for Clearance" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('zatca_onboarding_status','=', False), ('l10n_sa_invoice_type','!=', 'Standard'), ('zatca_status_code','!=','400'), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            context="{'xml_generate': 1}" groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                    <button name="send_for_reporting" type="object" string="ReSend to Zatca for Reporting" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|', '|', ('is_zatca', '=', False), ('state','!=','posted'), ('zatca_onboarding_status','=', False), ('l10n_sa_invoice_type','!=', 'Simplified'), ('zatca_status_code','!=','400'), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                            context="{'xml_generate': 1}" groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>

<!--                    <button name="zatca_response" type="object"-->
<!--                            string="View API response"-->
<!--                            class="oe_highlight"-->
<!--                            attrs="{'invisible':[('zatca_compliance_invoices_api','in', [0, None, '', False])]}"/>-->
                </xpath>
<!--                <xpath expr="//header" position="after">-->
<!--                    <div class="alert alert-danger mb-0" role="alert"-->
<!--                         attrs="{'invisible': [('zatca_invoice','!=', False)]}">-->
<!--                        If payment is made before <b>sending to zatca</b> then it will be considered a-->
<!--                        <b>pre payment invoice</b>.-->
<!--                    </div>-->
<!--                </xpath>-->
                <field name="payment_reference" position="after">
                    <field name="l10n_payment_means_code"
                           attrs="{'readonly': [('state', '!=', 'draft')],
                                   'invisible': ['|', ('is_zatca', '=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                           groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                </field>
                <xpath expr="//notebook//field[@name='invoice_line_ids']" position="after">
                    <span attrs="{'invisible': ['|', ('is_zatca', '=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                          groups="ksa_zatca_integration.l10n_sa_group_zatca_user">
                        <p>If no tax is selected then tax category 'O' is applied, with tax exemption text as "Not subject to VAT".</p>
                        <p>but tax must be selected.</p>
                    </span>
                </xpath>
                <xpath expr="//notebook" position="before">
                    <group string="Zatca Fields" attrs="{'invisible': ['|', ('is_zatca', '=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                           groups="ksa_zatca_integration.l10n_sa_group_zatca_user">
                        <group>
                            <field name="l10n_sa_invoice_type"
                                   attrs="{'required': [('is_zatca', '=', 'True'), ('invoice_date', '>', 'l10n_sa_phase1_end_date')],
                                           'readonly': ['|', ('state', '!=', 'draft'), ('l10n_sa_invoice_type_is_readonly', '=', True)]}"/>
                            <field name="l10n_is_third_party_invoice" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="l10n_is_exports_invoice" attrs="{'invisible':[('l10n_sa_invoice_type','=', 'Simplified')],
                                                                          'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="l10n_is_nominal_invoice" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="l10n_is_summary_invoice" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="l10n_is_self_billed_invoice" attrs="{'invisible':['|', ('l10n_is_exports_invoice','=', True),
                                                                                           ('l10n_sa_invoice_type','=', 'Simplified')],
                                                                              'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Zatca Response" attrs="{'invisible':['|', ('zatca_invoice','=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                          groups="ksa_zatca_integration.l10n_sa_group_zatca_user">
<!--                        <field name="l10n_sa_qr_code_str"/>-->
<!--                        <hr style="border: 1px solid black;"/>-->
<!--                        <field name="sa_qr_code_str"/>-->
<!--                        <hr style="border: 1px solid black;"/>-->
                        <group col="2">
                            <field name="zatca_invoice" filename="zatca_invoice_name"
                                   attrs="{'invisible':[('zatca_invoice','=', False)]}"/>
                            <field name="zatca_invoice_name" invisible="1"/>
                            <field name="zatca_hash_cleared_invoice_name" invisible="1"/>
                            <field name="zatca_hash_cleared_invoice" filename="zatca_hash_cleared_invoice_name"
                                   attrs="{'invisible':['|', ('zatca_hash_cleared_invoice','=', False), ('l10n_sa_invoice_type','=', 'Simplified')]}"/>
                        </group>
                        <hr style="border: 1px solid black;"/>
                        <field name="zatca_compliance_invoices_api"/>
                    </page>
                </xpath>
                <xpath expr="//field[@name='amount_residual']" position="after">
                    <field name="amount_tax_signed" class="oe_subtotal_footer_separator" string="Taxes (SAR)"
                           attrs="{'invisible': ['|', ('currency_id', '=', 'SAR'), ('zatca_invoice','=', False)]}"/>
                </xpath>
                <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                    <group>
                        <field name="ksa_note" attrs="{'readonly': [('state', '!=', 'draft')],
                                                       'invisible': ['|', ('is_zatca', '=', False), ('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                               groups="ksa_zatca_integration.l10n_sa_group_zatca_user"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="zatca_response" model="ir.ui.view">
            <field name="name">account.move</field>
            <field name="model">account.move</field>
            <field name="priority" eval="1000"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="zatca_compliance_invoices_api"/>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>