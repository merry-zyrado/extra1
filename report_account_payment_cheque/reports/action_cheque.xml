        <record id="action_account_paid_cheque" model="ir.actions.report">
            <field name="name">Voucher</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">report_account_payment_cheque.account_paid_cheque</field>
            <field name="report_file">report_account_payment_cheque.account_paid_cheque</field>
            <field name="print_report_name">(object.name).replace('/', '')</field>
            <field name="attachment">((object.name or 'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_type">report</field>
        </record>

        <record id="paperformat_action_account_paid_cheque" model="report.paperformat">
		    <field name="name">Voucher</field>
		    <field name="default" eval="True"/>
		    <field name="format">custom</field>
		    <field name="page_height">130</field>
			<field name="page_width">210</field>
			<field name="orientation">Portrait</field>
			<field name="margin_top">25</field>
			<field name="margin_bottom">5</field>
			<field name="margin_left">2</field>
			<field name="margin_right">2</field>
			<field name="header_line" eval="False"/>
			<field name="header_spacing">20</field>
			<field name="dpi">90</field>
            <field name="report_ids" eval="[(6,0,[ref('report_account_payment_cheque.action_account_paid_cheque')])]"/>
    	</record>

   </data>
</odoo>