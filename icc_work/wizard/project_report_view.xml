<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="food_driver_day_id" model="ir.ui.view">
            <field name="name">Print Project Report </field>
            <field name="model">project.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_to" />
                        </group>
                        <group>
                            <field name="date_from"/>

                            <field name="project_ids" widget="many2many_tags"/>
                        </group>

                    </group>
                    <footer>
                        <button name="action_print_product_moves_pdf_1" type="object" string="Confirm" class="oe_highlight"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="driver_day_id" model="ir.actions.act_window">
            <field name="name"> Print Project Report </field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="food_driver_day_id"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_custom" name=" Print Project Report" action="driver_day_id"         sequence="12"
/>


    </data>
</odoo>