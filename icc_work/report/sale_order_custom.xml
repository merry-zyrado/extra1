    <record id="paperformat_quotation_custom" model="report.paperformat">
        <field name="name">Leave quotation</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">40</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">37</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="print_new_sale_order"
            model="sale.order"
            string="Sale Order Custom "
            report_type="qweb-pdf"
            name="icc_work.sale_order_custom"
            file="icc_work.sale_order_custom"
            paperformat="icc_work.paperformat_quotation_custom"
            print_report_name="(object._get_report_base_filename_plient_appendix1())"
    />

