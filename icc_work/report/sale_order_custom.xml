                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="0"/>
                        <t t-foreach="doc.order_line" t-as="line">
                            <t  t-set="counter" t-value="counter + 1"/>


                            <tr style="text-align: center;">
                                <t t-if="line.price_unit == 0 and line.product_uom_qty == 0 ">
                                    <td style="vertical-align: middle  ;width:100%" align="center" colspan="8">
                                        <t  t-set="counter" t-value="counter - 1"/>

                                        <span t-field="line.name"/>


                                    </td>

                                </t>
                                <t t-if="line.price_unit != 0">

                                    <td style="vertical-align: middle  ;%" align="center"><span t-esc="counter"/></td>
                                    <td style="vertical-align: middle  ;" align="center"> <span t-field="line.product_template_id"/></td>
                                    <td style="vertical-align: middle  ;width:35%" align="left"> <span t-field="line.name"/></td>
                                    <t t-if="doc.show_photo == False">

                                        <td style="vertical-align: middle  ;" align="center">
                                            <span
                                                    t-field="line.product_id.image_128"
