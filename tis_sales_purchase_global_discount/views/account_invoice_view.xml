<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_invoice_discount_form">
        <field name="name">invoice.discount.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_subtotal_footer','oe_right')]" position="before">
                <group colspan="2" class="oe_left">
                    <field name="discount_for" required="0"/>
                    <field name="discount_type" class="oe_right" attrs="{'required': [('discount_for', '!=', False)]}"/>
                    <field name="discount_rate" attrs="{'required': [('discount_type', '!=', False)]}"/>
                    <field name="discount_narration"/>
                </group>
            </xpath>
            <field name="tax_totals" position="before">
                <field name="amount_untaxed_before_global_discounts" string="Untaxed Amount Before Disc." attrs="{'invisible': [('discount_for', '=', 'total')]}"/>
                <div class="oe_subtotal_footer_separator oe_inline o_td_label" attrs="{'invisible': [('discount_for', '=', 'untaxed')]}">
                    <label for="amount_grand"/>
                </div>
                <field name="amount_grand" nolabel="1" class="oe_subtotal_footer_separator" widget='monetary' options="{'currency_field': 'currency_id'}" attrs="{'invisible': [('discount_for', '=', 'untaxed')]}"/>
                <field name="amount_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
            </field>
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="global_discount_item" invisible="1"/>
                <field name="tax_line_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="account_move_line_form">
        <field name="name">invoice.move.line.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <group colspan="2" class="oe_left">
                    <field name="global_discount_item"/>
                    <field name="base_before_global_discounts" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>