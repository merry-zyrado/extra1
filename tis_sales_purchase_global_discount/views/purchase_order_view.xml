<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_purchase_order_discount_form">
        <field name="name">purchase.order.discount.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_subtotal_footer','oe_right')]" position="before">
                <group colspan="2" class="oe_left">
                    <field name="discount_for" class="oe_left" widget="radio"/>
                    <field name="discount_type" class="oe_left"/>
                    <field name="discount_rate" attrs="{'required': [('discount_type', '!=', False)]}"/>
                    <field name="discount_narration"/>
                </group>
            </xpath>
            <field name="price_unit" position="after">
                <field name="amount_after_discount" invisible="1"/>
            </field>
            <field name="tax_totals" position="before">
                <field name="amount_untaxed_before_global_discounts"/>
                <div class="oe_subtotal_footer_separator oe_inline o_td_label"
                    invisible="1">
                    <label for="amount_grand"/>
                </div>
                <field name="amount_grand" nolabel="1" class="oe_subtotal_footer_separator" widget='monetary'
                       options="{'currency_field': 'currency_id'}"
                       invisible="1"/>
                <field name="amount_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
            </field>
        </field>
    </record>
    <template id="portal_purchase_global_discount"
              name="Portal Purchase Global discount"
              inherit_id="purchase.purchase_order_portal_content_totals_table" priority="20">
        <xpath expr="//t[@t-set='tax_totals']" position="after">
            <tr  class="border-black o_subtotal">
                <td><strong>Amount Untaxed Before Discount</strong></td>
                <td class="text-end">
                        <span
                            t-att-class="oe_subtotal_footer_separator"
                            t-esc="order.amount_untaxed_before_global_discounts"
                            t-options='{"widget": "monetary", "display_currency": order.currency_id}'
                        />
                    </td>
            </tr>
            <tr  class="border-black o_subtotal">
                <td><strong>Discount</strong></td>
                <td class="text-end">
                        <span
                            t-att-class="oe_subtotal_footer_separator"
                            t-esc="order.amount_discount"
                             t-options='{"widget": "monetary", "display_currency": order.currency_id}'
                        />
                    </td>
            </tr>
        </xpath>
    </template>
</odoo>